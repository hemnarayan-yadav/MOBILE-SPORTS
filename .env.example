# -----------------------------------------------------------------------------
# Mobile environment variables
# Copy this file to `.env` for local development. Never commit `.env`.
# Every EXPO_PUBLIC_* value is PUBLIC: it is compiled into the app bundle and
# can be read by anyone with the APK. Never put a secret here.
# Staging and production builds get their values from the EAS build profiles
# (eas.json), not from this file. The app refuses to start when a value is
# missing or invalid (src/config/env.js).
# -----------------------------------------------------------------------------

# development | staging | production — also selects the Android package
# (in.khelscore.app.dev / .staging / no suffix) in app.config.js.
EXPO_PUBLIC_APP_ENV=development

# REST API base URL. On a USB-connected phone, `adb reverse tcp:5000 tcp:5000`
# makes the laptop's localhost reachable; the Android emulator uses 10.0.2.2.
# Staging and production must be https.
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# Socket.io server origin (same backend host, without /api/v1)
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# Canonical origin of the public website (share links, legal pages)
EXPO_PUBLIC_SITE_URL=https://www.khelscore.in

# Language before the user picks one: en | hi (English is the default)
EXPO_PUBLIC_DEFAULT_LOCALE=en
