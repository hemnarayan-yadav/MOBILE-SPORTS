# Dependencies
node_modules/

# Env files (never commit real values). EXPO_PUBLIC_* values ship in the app
# bundle and are public, but local URLs and experiments stay out of Git.
.env
.env.*
!.env.example

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects are generated by `expo prebuild` (Continuous Native
# Generation): app.config.js is the source of truth, never android/ or ios/.
/android
/ios
.kotlin/

# Signing material and credentials — never in Git
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
google-services.json
GoogleService-Info.plist
credentials.json

# Metro
.metro-health-check*

# Build output / test
build/
coverage/
*.apk
*.aab

# Logs
logs/
*.log
npm-debug.*

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test / cache
.cache/
.eslintcache
